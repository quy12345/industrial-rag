APP_NAME=Industrial Technical Manual RAG
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=/api/v1
QDRANT_URL=http://localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=industrial_manual_chunks
DENSE_VECTOR_NAME=dense
QDRANT_HYBRID_COLLECTION=industrial_manual_chunks_v2
SPARSE_VECTOR_NAME=sparse
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_DIR=
EMBEDDING_BATCH_SIZE=16
SPARSE_MODEL=Qdrant/bm25
SPARSE_EMBEDDING_BATCH_SIZE=64
BM25_DISABLE_STEMMER=true
BM25_K=1.2
BM25_B=0.75
# Leave blank to compute from the frozen 99 chunks during hybrid indexing.
BM25_AVG_LEN=
DENSE_CANDIDATE_LIMIT=20
SPARSE_CANDIDATE_LIMIT=20
HYBRID_FINAL_LIMIT=5
RRF_K=60
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=
