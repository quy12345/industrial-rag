APP_NAME=Industrial Technical Manual RAG
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=/api/v1
QDRANT_URL=http://localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=industrial_manual_chunks
DENSE_VECTOR_NAME=dense
QDRANT_HYBRID_COLLECTION=industrial_manual_chunks_v2
SPARSE_VECTOR_NAME=sparse
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_DIR=
EMBEDDING_BATCH_SIZE=16
SPARSE_MODEL=Qdrant/bm25
SPARSE_EMBEDDING_BATCH_SIZE=64
BM25_DISABLE_STEMMER=true
BM25_K=1.2
BM25_B=0.75
# Leave blank to compute from the frozen 99 chunks during hybrid indexing.
BM25_AVG_LEN=
DENSE_CANDIDATE_LIMIT=20
SPARSE_CANDIDATE_LIMIT=20
HYBRID_FINAL_LIMIT=5
RRF_K=60
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=
RETRIEVAL_STRATEGY=union
RERANK_ENABLED=true
EVIDENCE_SCORE_THRESHOLD=
GENERATION_MAX_CONTEXT_CHARS=24000
CITATION_EXCERPT_MAX_CHARS=400

# Generation provider: openai (Responses API) or gemini (OpenAI-compatible Chat Completions).
GENERATION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_REASONING_EFFORT=minimal
OPENAI_MAX_OUTPUT_TOKENS=800
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=1
OPENAI_STORE=false
