# Structured generation endpoint. Supported profiles:
# openai-responses, gemini-chat, openrouter-chat
GENERATION_ENDPOINT_PROFILE=gemini-chat
GENERATION_API_KEY=
GENERATION_MODEL=gemini-3.5-flash-lite
GENERATION_REASONING=minimal
GENERATION_TEMPERATURE=0
GENERATION_MAX_OUTPUT_TOKENS=800
GENERATION_TIMEOUT_SECONDS=60
GENERATION_MAX_RETRIES=1
GENERATION_STORE=false

# OpenRouter + pinned DeepSeek example:
# GENERATION_ENDPOINT_PROFILE=openrouter-chat
# GENERATION_MODEL=deepseek/deepseek-v4-flash-0731
# GENERATION_REASONING=disabled

# Frozen runtime mode
RETRIEVAL_STRATEGY=union
RERANK_ENABLED=true

# Optional Ragas evaluation only; keep this credential separate from generation.
OPENROUTER_API_KEY=

# Optional API authentication
API_AUTH_ENABLED=false
API_AUTH_KEY=
